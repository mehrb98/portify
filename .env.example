# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/portfolio"

# The one account that can sign in to /admin
ADMIN_EMAIL="you@example.com"
# Create with: npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=""

# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=""
