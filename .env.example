# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/portfolio"

# The one account that can sign in to /admin. Create it with:
#   npm run create-admin -- "your password"
ADMIN_EMAIL="you@example.com"

# Better Auth: at least 32 random characters (`openssl rand -base64 32`) and the site's public URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public URL for canonical, Open Graph, sitemap and robots
SITE_URL="http://localhost:3000"
